{
  "name": "@unbroker-app/ubctl",
  "version": "0.5.0",
  "description": "Official Unbroker Cloud CLI",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "ubctl": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbroker-app/ubctl.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "NO_COLOR=1 node --import tsx --test $(find src -name '*.test.ts')",
    "format": "prettier --write .",
    "build:binary": "bun scripts/build.ts --compile",
    "dev:tui": "bun src/index.ts tui",
    "test:tui": "bun test src/tui"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.4.2",
    "solid-js": "1.9.12",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.50.0"
  }
}
