{
  "name": "@unbroker-app/ubctl",
  "version": "0.3.0",
  "description": "Official Unbroker Cloud CLI",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "ubctl": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbroker-app/ubctl.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js --banner=\"#!/usr/bin/env node\"",
    "prepublishOnly": "bun run build",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "format": "prettier --write ."
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.50.0"
  }
}
